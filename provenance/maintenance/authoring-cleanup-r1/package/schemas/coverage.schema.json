{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source_commit",
    "reviewed_scope",
    "rows"
  ],
  "properties": {
    "source_commit": {
      "type": "string"
    },
    "reviewed_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_path",
          "source_section",
          "status",
          "destinations",
          "reason"
        ],
        "properties": {
          "source_path": {
            "type": "string"
          },
          "source_section": {
            "type": "string"
          },
          "status": {
            "enum": [
              "RESOLVED_CURRENT",
              "HISTORICAL_ONLY",
              "SUPERSEDED",
              "WORKING",
              "OPEN",
              "UNRESOLVED_REVIEW"
            ]
          },
          "destinations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "superseding_source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
