{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source_commit",
    "view_status",
    "topics"
  ],
  "properties": {
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "view_status": {
      "const": "resolved_authoring_view"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "view_paths",
          "owners",
          "open_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "view_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "owners": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "section",
                "status",
                "authority_reason"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "section": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "CURRENT",
                    "PARTIALLY_SUPERSEDED",
                    "HISTORICAL",
                    "WORKING",
                    "OPEN"
                  ]
                },
                "authority_reason": {
                  "type": "string"
                }
              }
            }
          },
          "open_status": {
            "type": "string"
          }
        }
      }
    }
  }
}
